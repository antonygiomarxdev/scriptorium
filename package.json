{
  "name": "@antonygiomarxdev/scriptorium",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Write the product before the code: a checked document chain (requests, product, PRDs, FRDs, UX, technical proposals, ADRs, specs) that AI coding agents write, build from and are reviewed against",
  "bin": {
    "scriptorium": "scripts/cli.ts"
  },
  "files": [
    "scripts"
  ],
  "scripts": {
    "check": "bun scripts/check.ts",
    "test": "bun test --timeout 120000",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version && bun scripts/sync-version.ts",
    "release": "changeset tag && git push --follow-tags",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
