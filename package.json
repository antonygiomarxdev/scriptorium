{
  "name": "scriptorium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Write the product before the code: a checked document chain for agent teams, above spec-driven development",
  "scripts": {
    "check": "bun scripts/check.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version && bun scripts/sync-version.ts",
    "release": "changeset tag && git push --follow-tags"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
