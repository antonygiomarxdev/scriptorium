{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook-doc-check.ts"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook-stop.ts"
            ]
          }
        ]
      }
    ]
  }
}
